{
  "name": "handmake-journal",
  "version": "0.1.0",
  "description": "Floating scrapbook journal with quick capture and canvas editing.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.handmake.journal",
    "productName": "Handmake Journal",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon/**/*",
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*",
      "!dist/**/*"
    ],
    "win": {
      "icon": "icon/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "asar": true
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
